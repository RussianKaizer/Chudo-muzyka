<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Если у вас стоит .NET 8 или 9 SDK, замените на net8.0-windows / net9.0-windows -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LyricsPlayer</AssemblyName>
    <RootNamespace>LyricsPlayer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- NAudio: воспроизведение mp3/wav/flac/m4a; TagLibSharp: чтение исполнителя и названия из тегов -->
    <PackageReference Include="NAudio" Version="2.*" />
    <PackageReference Include="TagLibSharp" Version="2.*" />
  </ItemGroup>

</Project>
